# ==========================================================
# AI-Native Support Ticket Triage System - Environment Config
# ==========================================================

# LLM Provider Selection: "auto", "mock", "openai", "anthropic", "gemini"
# "auto" detects available API keys, or defaults to "mock" for 100% offline zero-cost execution.
LLM_PROVIDER=auto

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Triage & Confidence Thresholds
AUTO_SEND_CONFIDENCE_THRESHOLD=0.85
TOP_K_RAG_RESULTS=2
